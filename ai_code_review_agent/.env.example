# Copy this file to ".env" and fill in your own values.
# Never commit a real ".env" with live keys.

# ---- LLM provider ----------------------------------------------------
# One of: openai | anthropic | google_genai | ollama | groq
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0

# Set only the key for the provider you chose above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Embeddings (Secure Coding Knowledge Base) -------------------------
# "huggingface" runs fully locally/offline -- no API key needed (default).
# "openai" uses text-embedding-3-small and requires OPENAI_API_KEY.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

COLLECTION_NAME=secure_coding_kb

# ---- Submission limits --------------------------------------------------
MAX_CODE_CHARS=60000
